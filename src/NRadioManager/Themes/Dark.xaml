<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题调色板（默认） -->
    <SolidColorBrush x:Key="B.Bg" Color="#FF0E1319" />
    <SolidColorBrush x:Key="B.BgElevated" Color="#FF131A22" />
    <SolidColorBrush x:Key="B.Surface" Color="#FF161D26" />
    <SolidColorBrush x:Key="B.SurfaceAlt" Color="#FF1C2530" />
    <SolidColorBrush x:Key="B.SurfaceHover" Color="#FF22303E" />
    <SolidColorBrush x:Key="B.Border" Color="#FF26313E" />
    <SolidColorBrush x:Key="B.BorderSoft" Color="#FF1E2833" />
    <SolidColorBrush x:Key="B.Text" Color="#FFE6EDF3" />
    <SolidColorBrush x:Key="B.TextMuted" Color="#FF8B9AAB" />
    <SolidColorBrush x:Key="B.TextFaint" Color="#FF64748B" />
    <SolidColorBrush x:Key="B.Accent" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="B.AccentSoft" Color="#FF1E3A5F" />
    <SolidColorBrush x:Key="B.AccentText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="B.Success" Color="#FF22C55E" />
    <SolidColorBrush x:Key="B.Warn" Color="#FFF59E0B" />
    <SolidColorBrush x:Key="B.Danger" Color="#FFEF4444" />
    <SolidColorBrush x:Key="B.DangerSoft" Color="#FF3A1B1B" />
    <SolidColorBrush x:Key="B.Cyan" Color="#FF22D3EE" />
    <SolidColorBrush x:Key="B.NavSelected" Color="#FF1E3A5F" />
    <SolidColorBrush x:Key="B.Scrim" Color="#CC0E1319" />

    <!-- 图表专用（随主题切换，保证两种主题下都可读） -->
    <SolidColorBrush x:Key="B.ChartBg" Color="#FF121820" />
    <SolidColorBrush x:Key="B.ChartGrid" Color="#FF242F3C" />
    <SolidColorBrush x:Key="B.ChartText" Color="#FF7C8B9C" />
    <SolidColorBrush x:Key="B.Down" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="B.Up" Color="#FF22D3EE" />
    <SolidColorBrush x:Key="B.Bar2" Color="#FF8B5CF6" />

    <Color x:Key="C.Accent">#FF3B82F6</Color>
    <Color x:Key="C.AccentSoft">#FF1E3A5F</Color>
</ResourceDictionary>
