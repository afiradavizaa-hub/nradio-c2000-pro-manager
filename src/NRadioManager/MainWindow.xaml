<Window x:Class="NRadioManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NRadioManager.ViewModels"
        xmlns:views="clr-namespace:NRadioManager.Views"
        xmlns:controls="clr-namespace:NRadioManager.Controls"
        Title="NRadio C2000 Pro 高级管理器" Height="820" Width="1280" MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource B.Bg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CellularViewModel}">
            <views:CellularView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WifiViewModel}">
            <views:WifiView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LanViewModel}">
            <views:LanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
            <views:DevicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatteryViewModel}">
            <views:BatteryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:C2000CellularViewModel}">
            <views:C2000CellularView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:C2000SignalViewModel}">
            <views:C2000SignalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:C2000LockViewModel}">
            <views:C2000LockView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:C2000SimViewModel}">
            <views:C2000SimView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:C2000WifiViewModel}">
            <views:C2000WifiView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:C2000SmsViewModel}">
            <views:C2000SmsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:C2000MaintenanceViewModel}">
            <views:C2000MaintenanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}">
            <views:SystemView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewModel}">
            <views:LogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="ScaleHost">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧导航 ==================== -->
        <Border Grid.Column="0" Background="{DynamicResource B.Surface}"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,22,20,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource B.Accent}">
                            <TextBlock Text="&#xE839;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" Foreground="{DynamicResource B.AccentText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="NRadio C2000 Pro" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="NRadio C2000 Pro · 高级网络管理" FontSize="11" Foreground="{DynamicResource B.TextFaint}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding NavItems}" Margin="12,0,12,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectNavCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" Margin="0,0,0,2">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource B.NavSelected}" />
                                                <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" Width="26" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="2" Margin="20,10,20,18">
                    <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="10" Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource B.Danger}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource B.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ConnectionStateText}" Margin="8,0,0,0" FontSize="12" />
                                <TextBlock Text="{Binding PollHint}" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource B.TextFaint}" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding Settings.Host}" FontSize="11" Margin="0,6,0,0"
                                       Foreground="{DynamicResource B.TextMuted}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 右侧内容 ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PageHeader}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding SelectedNav.Title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource GhostButton}"
                                Padding="10,8" ToolTip="切换日间 / 夜间模式" Margin="0,0,10,0">
                            <TextBlock Text="{Binding ThemeGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                        </Button>
                        <TextBlock Text="刷新间隔" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                        <TextBox Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=LostFocus}" Width="46"
                                 TextAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="秒" Style="{StaticResource FieldLabel}" Margin="0,0,14,0" />
                        <Button Content="刷新全部" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Command="{Binding RefreshAllCommand}" />
                        <Button Content="重新连接" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConnectCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding SelectedNav.Module}" Margin="20,16,20,0" />
        </Grid>

        <!-- ==================== 未连接：登录面板 ==================== -->
        <Grid Grid.ColumnSpan="2" Background="{DynamicResource B.Scrim}"
              Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibility}}">
            <Border Width="440" Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Border}"
                    BorderThickness="1" CornerRadius="{DynamicResource R.CardRadius}" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="连接 NRadio C2000 Pro" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,10,0,20"
                               Text="请确认电脑已连接到该路由器的 Wi-Fi 或有线网络。软件使用设备原厂后台的登录方式直连，不经过任何第三方服务器。" />

                    <TextBlock Text="设备地址" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <TextBlock Text="密码" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PwdBox" PasswordChanged="OnPasswordChanged" Margin="0,0,0,12" />

                    <CheckBox Style="{StaticResource Switch}" Content="记住密码（Windows DPAPI 加密，仅本机当前用户可解密）"
                              IsChecked="{Binding RememberPassword}" Margin="0,0,0,18" FontSize="12" />

                    <Button Content="连接" Style="{StaticResource PrimaryButton}" Height="40"
                            Command="{Binding ConnectCommand}" />

                    <TextBlock Text="{Binding ConnectionStateText}" Style="{StaticResource Note}" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource B.Danger}" TextWrapping="Wrap"
                               Margin="0,8,0,0" FontSize="12"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 统一通知中心（覆盖全部页面） ====================
             位置固定在右下角：右上角原本会压住概览页的「完成 / 编辑磁贴」按钮，
             通知自身带点击处理器，会把点击吞掉，导致按钮"点了没反应"。
             没有通知时整体隐藏，完全不参与命中测试。 -->
        <Grid Grid.Column="1" Panel.ZIndex="60" Margin="0,0,20,20" MaxWidth="420"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Visibility="{Binding Notices.HasItems, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Button Content="清除全部" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12"
                        HorizontalAlignment="Right" Margin="0,0,0,8"
                        Command="{Binding Notices.ClearAllCommand}"
                        Visibility="{Binding Notices.HasItems, Converter={StaticResource BoolToVisibility}}" />

                <controls:NoticeStack ItemsSource="{Binding Notices.Items}">
                    <controls:NoticeStack.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="noticeRoot" MaxHeight="320" Opacity="1" Margin="0,0,0,8"
                                    Background="{DynamicResource B.BgElevated}"
                                    BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                                    CornerRadius="{DynamicResource R.CardRadius}"
                                    UseLayoutRounding="True" SnapsToDevicePixels="True"
                                    MouseLeftButtonUp="OnNoticeClicked" Cursor="Hand">
                                <!-- 这里原本有 DropShadowEffect：位图 Effect 会让 WPF 把整个子树渲染到中间位图，
                                     亚像素渲染（ClearType）随之失效，文字必然发虚。去掉它，改用边框区分层次。 -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRemoving}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                                                             Duration="0:0:0.18" />
                                                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="0"
                                                                             Duration="0:0:0.18" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 状态色条 -->
                                    <Rectangle Grid.Column="0" RadiusX="2" RadiusY="2">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="{DynamicResource B.Accent}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Success">
                                                        <Setter Property="Fill" Value="{DynamicResource B.Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Fill" Value="{DynamicResource B.Warn}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Fill" Value="{DynamicResource B.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>

                                    <StackPanel Grid.Column="1" Margin="12,10,8,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Note}"
                                                       Margin="8,0,0,0" VerticalAlignment="Bottom" />
                                            <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="4"
                                                    Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="已折叠 · 点击展开" FontSize="10"
                                                           Foreground="{DynamicResource B.TextMuted}" />
                                            </Border>
                                        </StackPanel>
                                        <!-- 取值必须是 None / CharacterEllipsis / WordEllipsis；
                                             之前误写成 TailTrimming，导致通知模板一加载就抛 XamlParseException -->
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource Note}" Margin="0,4,0,0"
                                                   MaxHeight="120" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsExpandedContent, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource GhostButton}"
                                            Padding="7,4" Margin="0,8,8,0" VerticalAlignment="Top" FontSize="11"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            ToolTip="删除这条通知"
                                            Command="{Binding RemoveCommand}"
                                            Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </controls:NoticeStack.ItemTemplate>
                </controls:NoticeStack>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
