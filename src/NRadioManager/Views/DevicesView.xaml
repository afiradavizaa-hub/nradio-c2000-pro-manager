<UserControl x:Class="NRadioManager.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NRadioManager.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="接入终端" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource FieldValue}">
                        <Run Text="在线 " /><Run Text="{Binding OnlineCount, Mode=OneWay}" />
                        <Run Text=" 台 · 历史记录 " /><Run Text="{Binding KnownDeviceCount, Mode=OneWay}" /><Run Text=" 台" />
                    </TextBlock>
                    <TextBlock Text="{Binding TotalBanner}" Style="{StaticResource Note}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding CounterWarning}" Style="{StaticResource Note}" Margin="0,4,0,0"
                               Foreground="{DynamicResource B.Warn}"
                               Visibility="{Binding HasCounterWarning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="清零全部流量" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Command="{Binding ResetStatsCommand}" />
                    <Button Content="刷新" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Clients}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="185" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                            <Border Background="{DynamicResource B.AccentSoft}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                    Visibility="{Binding CustomNamed, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="自定义" FontSize="10" />
                                            </Border>
                                            <Border Background="{DynamicResource B.DangerSoft}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                    Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="禁止上网" FontSize="10" Foreground="{DynamicResource B.Danger}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Note}" Margin="0,5,0,0">
                                            <Run Text="{Binding Ip, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding ConnType, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Hostname}" Style="{StaticResource Note}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Mac}" Style="{StaticResource Note}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="本机显示累计" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding UsageTotalText}" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource B.Accent}" Margin="0,3,0,0" />
                                        <TextBlock Style="{StaticResource Note}" Margin="0,3,0,0">
                                            <Run Text="↓ " /><Run Text="{Binding TotalRx, Mode=OneWay}" />
                                            <Run Text=" · ↑ " /><Run Text="{Binding TotalTx, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="详情" Style="{StaticResource PrimaryButton}" Padding="11,5"
                                                Command="{Binding DataContext.SelectDeviceCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Column="1" Width="420" Margin="14,0,0,0" VerticalAlignment="Stretch"
                    Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Border}"
                    BorderThickness="1" CornerRadius="{DynamicResource R.CardRadius}" Padding="16"
                    Visibility="{Binding DetailVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource SectionTitle}" />
                            <Button Content="关闭" Style="{StaticResource GhostButton}" Padding="10,4"
                                    HorizontalAlignment="Right" Command="{Binding CloseDetailCommand}" />
                        </Grid>

                        <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="{DynamicResource R.Small}"
                                Padding="12" Margin="0,2,0,12">
                            <StackPanel>
                                <TextBlock Text="累计用量" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding DetailUsageTotal}" FontSize="22" FontWeight="SemiBold"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding DetailUsageSource}" Style="{StaticResource Note}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="自定义名称" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding AliasInput, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="保存" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    Command="{Binding SaveAliasCommand}" />
                            <Button Grid.Column="2" Content="清除" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding ClearAliasCommand}" />
                        </Grid>

                        <TextBlock Text="手动累计用量 (GB)" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ManualUsageInputGb, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="应用" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    Command="{Binding SaveUsageCommand}" />
                            <Button Grid.Column="2" Content="清零" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                    Command="{Binding ResetSelectedUsageCommand}" />
                            <Button Grid.Column="3" Content="用原始值" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                    Command="{Binding UseRawUsageCommand}" />
                        </Grid>
                        <TextBlock Text="手动值是自动增长的起点，不是静态截图：后续设备计数器增量会继续累加。"
                                   Style="{StaticResource Note}" Margin="0,5,0,0" />

                        <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0">
                            <Run Text="{Binding DetailHostname, Mode=OneWay}" /><Run Text=" · " />
                            <Run Text="{Binding DetailIp, Mode=OneWay}" /><Run Text=" · " />
                            <Run Text="{Binding DetailMac, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Text="流量周期" Style="{StaticResource ListHeader}" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource FieldValue}" Margin="0,2,0,0">
                            <Run Text="今日 " /><Run Text="{Binding DetailToday, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource FieldValue}" Margin="0,4,0,0">
                            <Run Text="近七天 " /><Run Text="{Binding DetailWeek, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource FieldValue}" Margin="0,4,0,0">
                            <Run Text="本月 " /><Run Text="{Binding DetailMonthDevice, Mode=OneWay}" />
                        </TextBlock>

                        <controls:BarChart Items="{Binding DeviceBars}" Height="140" Margin="0,10,0,0"
                                           EmptyText="该终端近七天没有本地采样记录" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="禁止上网" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                    Command="{Binding BlockCommand}" CommandParameter="{Binding Selected}" />
                            <Button Content="解除限制" Style="{StaticResource GhostButton}"
                                    Command="{Binding UnblockCommand}" CommandParameter="{Binding Selected}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
