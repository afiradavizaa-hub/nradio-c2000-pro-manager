<UserControl x:Class="NRadioManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="{DynamicResource R.Small}" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource B.DangerSoft}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ================= A 外观 ================= -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="外观与个性化" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="夜间模式" GroupName="Theme" IsChecked="{Binding ThemeDark}" />
                            <RadioButton Content="日间模式" GroupName="Theme" IsChecked="{Binding ThemeLight}" />
                            <RadioButton Content="跟随系统" GroupName="Theme" IsChecked="{Binding ThemeSystem}" />
                        </StackPanel>

                        <TextBlock Text="强调色" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding AccentPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="26" Height="26" Margin="0,0,8,0" Cursor="Hand"
                                                Command="{Binding DataContext.PickAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{Binding}" CornerRadius="8" BorderThickness="1"
                                                            BorderBrush="{DynamicResource B.Border}" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Text="{Binding AccentColor, UpdateSourceTrigger=LostFocus}" Width="110" />
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="磁贴圆角" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="28" Value="{Binding TileCornerRadius}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TileCornerRadius, StringFormat={}{0:0} px}" Style="{StaticResource FieldLabel}" Margin="12,0,0,0" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="磁贴间距" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="4" Maximum="24" Value="{Binding TileSpacing}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TileSpacing, StringFormat={}{0:0} px}" Style="{StaticResource FieldLabel}" Margin="12,0,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="磁贴内边距" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="8" Maximum="28" Value="{Binding TilePadding}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding TilePadding, StringFormat={}{0:0} px}" Style="{StaticResource FieldLabel}" Margin="12,0,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="界面缩放" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <Slider Grid.Row="3" Grid.Column="1" Minimum="0.85" Maximum="1.3" TickFrequency="0.05"
                                    Value="{Binding UiScale}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding UiScale, StringFormat={}{0:0.00}×}" Style="{StaticResource FieldLabel}" Margin="12,0,0,0" />
                        </Grid>

                        <CheckBox Style="{StaticResource Switch}" Content="启用界面动画与过渡效果" IsChecked="{Binding AnimationsEnabled}" Margin="0,14,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="恢复默认外观" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                    Command="{Binding ResetAppearanceCommand}" />
                            <Button Content="恢复默认磁贴布局" Style="{StaticResource GhostButton}"
                                    Command="{Binding ResetTilesCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= B 数据与流量 ================= -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="数据与流量统计" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="流量单位" Style="{StaticResource FieldLabel}" Margin="0,6,10,6" />
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding UnitOptions}" DisplayMemberPath="Text"
                                      SelectedItem="{Binding SelectedUnit}" Margin="0,4,20,4" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="默认统计视图" Style="{StaticResource FieldLabel}" Margin="0,6,10,6" />
                            <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding PeriodOptions}" DisplayMemberPath="Text"
                                      SelectedItem="{Binding SelectedPeriod}" Margin="0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="历史保留天数" Style="{StaticResource FieldLabel}" Margin="0,6,10,6" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HistoryRetentionDays}" Margin="0,4,20,4" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="图表时间窗口(分钟)" Style="{StaticResource FieldLabel}" Margin="0,6,10,6" />
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ChartWindowMinutes}" Margin="0,4" />
                        </Grid>

                        <TextBlock Text="{Binding DataSourceText}" Style="{StaticResource Note}" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding StorageText}" Style="{StaticResource Note}" Margin="0,6,0,0" />

                        <Button Content="清理本地流量历史" Style="{StaticResource GhostButton}" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Command="{Binding ClearHistoryCommand}" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                   Text="该操作只删除电脑上的采样数据，不会重置路由器内部的累计流量计数器，两者互不影响。" />
                    </StackPanel>
                </Border>

                <!-- ================= B2 电池监测 ================= -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="电池监测" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="采样间隔" Style="{StaticResource FieldLabel}" Margin="0,6,10,6" />
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding BatterySampleOptions}"
                                      DisplayMemberPath="Text" SelectedItem="{Binding SelectedBatterySample}" Margin="0,4,20,4" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="历史保留" Style="{StaticResource FieldLabel}" Margin="0,6,10,6" />
                            <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding BatteryRetentionOptions}"
                                      DisplayMemberPath="Text" SelectedItem="{Binding SelectedBatteryRetention}" Margin="0,4" />
                        </Grid>
                        <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                                   Text="电池采样复用现有 status_info 轮询，不新增 HTTP 请求或后台进程。电量变化慢，默认每 1 分钟记录一次；设备断连时写入断开标记，图表不会跨缺口连线。" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0"
                                   Text="设备仅提供 battery_percent、battery_charge、battery_charging 和语义未确认的 battery_connect；电压、电流、温度、剩余时间、Wh 均不提供，本软件不做估算。" />
                        <Button Content="清理本地电池历史" Style="{StaticResource GhostButton}" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Command="{Binding BatteryClearHistoryCommand}" />
                    </StackPanel>
                </Border>

                <!-- ================= C 设备连接 ================= -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="设备连接" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding ConnectionStateText}" Style="{StaticResource FieldValue}" />
                        <TextBlock Text="{Binding AuthStateText}" Style="{StaticResource Note}" Margin="0,6,0,0" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="设备地址" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" Text="{Binding HostText}" />
                            <TextBlock Grid.Column="2" Text="用户名" Style="{StaticResource FieldLabel}" Margin="18,0,10,0" />
                            <TextBox Grid.Column="3" Text="{Binding UserNameText}" />
                            <TextBlock Grid.Column="4" Text="超时(秒)" Style="{StaticResource FieldLabel}" Margin="18,0,10,0" />
                            <TextBox Grid.Column="5" Text="{Binding TimeoutSeconds}" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="密码" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <PasswordBox Grid.Column="1" PasswordChanged="OnPasswordChanged" />
                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" Content="记住密码（DPAPI 加密保存）"
                                      IsChecked="{Binding RememberPassword}" Margin="18,0,0,0" />
                        </Grid>
                        <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                                   Text="修改地址或账号时会先用新参数实际连接验证，验证通过才保存，不会让原有配置莫名失效。" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="验证并保存连接配置" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    Command="{Binding ApplyConnectionCommand}" />
                            <Button Content="立即重新连接" Style="{StaticResource GhostButton}"
                                    Command="{Binding ReconnectCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= D 采样与性能 ================= -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="数据采样与性能" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="状态刷新(秒)" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" Text="{Binding PollIntervalSeconds}" />
                            <TextBlock Grid.Column="2" Text="速率采样(秒)" Style="{StaticResource FieldLabel}" Margin="18,0,10,0" />
                            <TextBox Grid.Column="3" Text="{Binding SpeedSampleSeconds}" />
                            <TextBlock Grid.Column="4" Text="终端刷新(秒)" Style="{StaticResource FieldLabel}" Margin="18,0,10,0" />
                            <TextBox Grid.Column="5" Text="{Binding DeviceRefreshSeconds}" />
                        </Grid>
                        <TextBlock Text="{Binding SampleStatusText}" Style="{StaticResource Note}" Margin="0,10,0,0" />
                        <CheckBox Style="{StaticResource Switch}" Content="窗口最小化时暂停轮询（省电、减少设备负担）"
                                  IsChecked="{Binding PauseWhenMinimized}" Margin="0,10,0,0" />
                        <CheckBox Style="{StaticResource Switch}" Content="低性能模式（关闭动画，降低刷新）"
                                  IsChecked="{Binding LowPerformanceMode}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                   Text="刷新频率已做下限约束（状态 2–60 秒、终端 15–120 秒），不会对设备产生不受控的高频请求。" />
                    </StackPanel>
                </Border>

                <!-- ================= E 通知 ================= -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="通知与告警" Style="{StaticResource SectionTitle}" />
                        <CheckBox Style="{StaticResource Switch}" Content="设备断连时提醒" IsChecked="{Binding NotifyDisconnect}" />
                        <CheckBox Style="{StaticResource Switch}" Content="设备恢复连接时提醒" IsChecked="{Binding NotifyReconnect}" />
                        <CheckBox Style="{StaticResource Switch}" Content="终端上线/离线时提醒（本地检测）" IsChecked="{Binding NotifyDeviceEvents}" />
                        <CheckBox Style="{StaticResource Switch}" Content="信号质量较差时提醒" IsChecked="{Binding NotifyWeakSignal}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="弱信号阈值（设备原始档位）" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <ComboBox ItemsSource="{Binding SignalThresholdOptions}" DisplayMemberPath="Text"
                                      SelectedItem="{Binding SelectedSignalThreshold}" Width="190" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0"
                                   Text="阈值只使用设备返回的 signal_quality 原始档位（0–5），连续 3 次采样确认后才提醒；恢复也需连续 3 次回到阈值以上。RSSI 只展示设备上报值，工程页 RSRP/RSRQ/SINR 是基带原始编码，均不参与阈值换算。" />

                        <CheckBox Style="{StaticResource Switch}" Content="流量达到阈值时提醒" IsChecked="{Binding NotifyTrafficThreshold}" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="统计周期" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <ComboBox ItemsSource="{Binding TrafficPeriodOptions}" DisplayMemberPath="Text"
                                      SelectedItem="{Binding SelectedTrafficPeriod}" Width="110" Margin="0,0,18,0" />
                            <TextBlock Text="阈值(GB)" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <TextBox Text="{Binding TrafficThresholdGb}" Width="100" />
                        </StackPanel>
                        <Button Content="发送测试通知" Style="{StaticResource GhostButton}" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Command="{Binding TestNotificationCommand}" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                   Text="流量阈值按本地真实采样统计，每个周期/阈值配置只提醒一次（跨软件重启保持去重）；周期切换后自动重新计数。软件未运行期间的流量无法还原，存在未采集时段时会明确标注。" />
                    </StackPanel>
                </Border>

                <!-- ================= E2 网络质量检测 ================= -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="网络质量检测（独立于设备接口）" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding NetworkQualityStateText}" Style="{StaticResource FieldValue}" />
                        <TextBlock Text="{Binding NetworkQualitySummary}" Style="{StaticResource Note}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding NetworkQualityRouter}" Style="{StaticResource Note}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding NetworkQualityInternet}" Style="{StaticResource Note}" Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding NetworkQualityLatency}" Style="{StaticResource Note}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding NetworkQualityLoss}" Style="{StaticResource Note}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding NetworkQualityTime}" Style="{StaticResource Note}" Margin="0,3,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="立即检测" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"
                                    Command="{Binding TestNetworkQualityCommand}" />
                            <CheckBox Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      Content="每 5 分钟自动检测（默认关闭）"
                                      IsChecked="{Binding NetworkQualityAutoCheck}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="检测使用 ICMP 与两个独立外网目标的 TCP 443 连接，不抓包、不安装服务。路由器不可达、外网连接失败、检测失败（超时/端口被拦截）会分别标注；ICMP 被丢弃时不会算作 100% 丢包。" />
                    </StackPanel>
                </Border>

                <!-- ================= F 启动与窗口 ================= -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="启动与窗口" Style="{StaticResource SectionTitle}" />
                        <CheckBox Style="{StaticResource Switch}" Content="记住窗口大小与位置" IsChecked="{Binding RememberWindowPlacement}" />
                        <CheckBox Style="{StaticResource Switch}" Content="启动后回到上次打开的页面" IsChecked="{Binding RememberLastPage}" />
                        <CheckBox Style="{StaticResource Switch}" Content="最小化到系统托盘（关闭按钮仍退出）" IsChecked="{Binding MinimizeToTray}" />
                        <CheckBox Style="{StaticResource Switch}" Content="开机自动启动（默认关闭，需显式开启）" IsChecked="{Binding StartWithWindows}" />
                        <TextBlock Text="{Binding StartupNote}" Style="{StaticResource Note}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- ================= G 备份与恢复 ================= -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="备份与恢复" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="导出设置" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    Command="{Binding ExportSettingsCommand}" />
                            <Button Content="导入设置" Style="{StaticResource GhostButton}"
                                    Command="{Binding ImportSettingsCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                                   Text="导出内容包含：界面外观、采样与通知设置、磁贴布局、设备自定义名称。备份中不含密码。" />
                    </StackPanel>
                </Border>

                <!-- ================= H 关于与诊断 ================= -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="关于与诊断" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource FieldValue}">
                            <Run Text="软件版本：" /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource FieldValue}" Margin="0,4,0,0">
                            <Run Text="当前设备：" /><Run Text="{Binding DeviceModel, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource FieldValue}" Margin="0,4,0,0">
                            <Run Text="运行环境：" /><Run Text="{Binding RuntimeText, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Text="尚未实现或无法实现的功能" Style="{StaticResource ListHeader}" Margin="0,14,0,6" />
                        <ItemsControl ItemsSource="{Binding NotImplemented}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource B.Warn}" VerticalAlignment="Top" Margin="0,6,8,0" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource Note}" MaxWidth="760" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="导出当前流量视图 CSV" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                    Command="{Binding ExportTrafficCsvCommand}" />
                            <Button Content="导出终端清单 CSV（脱敏）" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                    Command="{Binding ExportTerminalCsvCommand}" />
                            <Button Content="导出脱敏诊断日志" Style="{StaticResource GhostButton}"
                                    Command="{Binding ExportDiagnosticsCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                   Text="CSV 使用 UTF-8 编码，可直接用 Excel 打开。终端清单会对名称、主机名、MAC、IP 脱敏；诊断日志不包含密码、Cookie、摘要响应，并额外隐藏地址与终端标识。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
