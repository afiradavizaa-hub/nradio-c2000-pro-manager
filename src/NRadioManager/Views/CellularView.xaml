<UserControl x:Class="NRadioManager.Views.CellularView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="#3A1B1B" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
        </Border>

        <TabControl Grid.Row="1">
            <!-- ============ 连接设置 ============ -->
            <TabItem Header="连接设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="当前状态" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="连接状态" Style="{StaticResource FieldLabel}" Margin="0,5,18,5" />
                                    <TextBlock Grid.Column="1" Text="{Binding ConnectionState}" Style="{StaticResource FieldValue}" Margin="0,5" />
                                    <TextBlock Grid.Column="2" Text="运营商" Style="{StaticResource FieldLabel}" Margin="0,5,18,5" />
                                    <TextBlock Grid.Column="3" Text="{Binding Operator}" Style="{StaticResource FieldValue}" Margin="0,5" />
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="WAN IP" Style="{StaticResource FieldLabel}" Margin="0,5,18,5" />
                                    <TextBlock Grid.Column="1" Text="{Binding WanIp}" Style="{StaticResource FieldValue}" Margin="0,5" />
                                    <TextBlock Grid.Column="2" Text="SIM 状态" Style="{StaticResource FieldLabel}" Margin="0,5,18,5" />
                                    <TextBlock Grid.Column="3" Text="{Binding SimState}" Style="{StaticResource FieldValue}" Margin="0,5" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="拨号连接" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                            Command="{Binding ConnectDataCommand}" />
                                    <Button Content="断开连接" Style="{StaticResource GhostButton}"
                                            Command="{Binding DisconnectDataCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="连接模式" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="自动连接" IsChecked="{Binding IsAutoConnect}" />
                                    <RadioButton Content="手动连接" IsChecked="{Binding IsManualConnect}" />
                                </StackPanel>
                                <CheckBox Content="漫游时禁止自动拨号" IsChecked="{Binding DisableAutoDialOnRoaming}" Margin="0,10,0,0" />
                                <Button Content="保存连接模式" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                        HorizontalAlignment="Left" Command="{Binding SaveDialCommand}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="网络模式与 MTU" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Note}" Margin="0,0,0,12">
                                    <Run Text="可选网络模式由设备返回的默认能力（NW_mode_default：" />
                                    <Run Text="{Binding NwModeDefault, Mode=OneWay}" />
                                    <Run Text="）决定，与原厂后台的选项范围一致。" />
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="网络模式" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding NetworkModeOptions}"
                                              SelectedItem="{Binding SelectedNetworkMode}" DisplayMemberPath="Text" />
                                    <TextBlock Grid.Column="2" Text="FDD/TDD 优先" Style="{StaticResource FieldLabel}" Margin="18,0,10,0" />
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding PreferLteOptions}"
                                              SelectedItem="{Binding SelectedPreferLteType}" DisplayMemberPath="Text" />
                                    <TextBlock Grid.Column="4" Text="MTU" Style="{StaticResource FieldLabel}" Margin="18,0,10,0" />
                                    <TextBox Grid.Column="5" Text="{Binding MtuText}" />
                                </Grid>
                                <Button Content="保存网络设置" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                        HorizontalAlignment="Left" Command="{Binding SaveNetworkCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ APN ============ -->
            <TabItem Header="APN 配置">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="APN 列表" Style="{StaticResource SectionTitle}" />
                                <CheckBox Content="自动匹配 APN（运营商自动下发）" IsChecked="{Binding AutoApn}" Margin="0,0,0,8" />
                                <Button Content="保存自动 APN 设置" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                        Margin="0,0,0,10" Command="{Binding SaveAutoApnCommand}" />
                            </StackPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource B.TextMuted}">
                                                <Run Text="APN：" />
                                                <Run Text="{Binding Apn, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="新增" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Command="{Binding AddProfileCommand}" />
                                <Button Content="移除" Style="{StaticResource GhostButton}" Command="{Binding RemoveProfileCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="配置详情" Style="{StaticResource SectionTitle}" />
                            <Grid DataContext="{Binding SelectedProfile}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="配置名称" Style="{StaticResource FieldLabel}" Margin="0,6,12,6" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProfileName}" Margin="0,4,18,4" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="APN" Style="{StaticResource FieldLabel}" Margin="0,6,12,6" />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Apn}" Margin="0,4" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="LTE APN" Style="{StaticResource FieldLabel}" Margin="0,6,12,6" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LteApn}" Margin="0,4,18,4" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="IP 类型" Style="{StaticResource FieldLabel}" Margin="0,6,12,6" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding IpType}" Margin="0,4" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="鉴权方式" Style="{StaticResource FieldLabel}" Margin="0,6,12,6" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AuthType4G}" Margin="0,4,18,4" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="用户名 / 密码" Style="{StaticResource FieldLabel}" Margin="0,6,12,6" />
                                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Margin="0,4">
                                    <TextBox Text="{Binding User4G}" Width="110" />
                                    <TextBox Text="{Binding Password4G}" Width="110" Margin="8,0,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="是否默认" Style="{StaticResource FieldLabel}" Margin="0,6,12,6" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding IsDefault}" Margin="0,4,18,4" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="启用 / QCI" Style="{StaticResource FieldLabel}" Margin="0,6,12,6" />
                                <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" Margin="0,4">
                                    <TextBox Text="{Binding Enable}" Width="110" />
                                    <TextBox Text="{Binding Qci}" Width="110" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource Note}" Margin="0,14,0,0"
                                       Text="说明：字段取值沿用设备原厂定义（IP 类型 1=IPv4、2=IPv6、3=IPv4/IPv6；默认标记 1=是）。修改后点击下方按钮整表下发。" />

                            <Button Content="保存 APN 配置" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Command="{Binding SaveProfilesCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ 连接信息 ============ -->
            <TabItem Header="连接信息与小区">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="PDP 上下文" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource FieldValue}" Margin="0,0,0,10">
                                    <Run Text="网络：" />
                                    <Run Text="{Binding PdpNetworkName, Mode=OneWay}" />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding PdpContexts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource RowBorder}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="{Binding RuleName, Mode=OneWay}" />
                                                        <Run Text=" · IPv4 " Foreground="{DynamicResource B.TextMuted}" />
                                                        <Run Text="{Binding Ipv4, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0">
                                                        <Run Text="网关 " /><Run Text="{Binding V4Gateway, Mode=OneWay}" />
                                                        <Run Text=" · 掩码 " /><Run Text="{Binding V4Netmask, Mode=OneWay}" />
                                                        <Run Text=" · DNS " /><Run Text="{Binding V4Dns1, Mode=OneWay}" />
                                                        <Run Text=" / " /><Run Text="{Binding V4Dns2, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0">
                                                        <Run Text="IPv6 全局 " /><Run Text="{Binding GlobalIpv6, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0">
                                                        <Run Text="本次连接 " /><Run Text="{Binding CurConnTime, Mode=OneWay}" />
                                                        <Run Text=" 秒 · 累计 " /><Run Text="{Binding TotalConnTime, Mode=OneWay}" />
                                                        <Run Text=" 秒" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="LTE 工程参数（原厂「连接信息」页数据）" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding CellInfo}" Style="{StaticResource FieldValue}" />
                                <TextBlock Text="{Binding SignalRaw}" Style="{StaticResource FieldValue}" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding ThroughputRaw}" Style="{StaticResource FieldValue}" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding EngineeringNote}" Style="{StaticResource Note}" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
