<UserControl x:Class="NRadioManager.Views.LanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="#3A1B1B" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="局域网基本信息" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="路由器地址" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" Text="{Binding Ip}" />
                            <TextBlock Grid.Column="2" Text="子网掩码" Style="{StaticResource FieldLabel}" Margin="18,0,10,0" />
                            <TextBox Grid.Column="3" Text="{Binding Mask, Mode=OneWay}" IsEnabled="False" />
                            <TextBlock Grid.Column="4" Text="局域网域名" Style="{StaticResource FieldLabel}" Margin="18,0,10,0" />
                            <TextBox Grid.Column="5" Text="{Binding LanDomain, Mode=OneWay}" IsEnabled="False" />
                        </Grid>
                        <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0">
                            <Run Text="设备 MAC：" /><Run Text="{Binding Mac, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DHCP 服务" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="启用 DHCP 服务" IsChecked="{Binding DhcpEnabled}" IsEnabled="False" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="起始地址" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" Text="{Binding Start}" />
                            <TextBlock Grid.Column="2" Text="结束地址" Style="{StaticResource FieldLabel}" Margin="18,0,10,0" />
                            <TextBox Grid.Column="3" Text="{Binding End}" />
                            <TextBlock Grid.Column="4" Text="租期（秒）" Style="{StaticResource FieldLabel}" Margin="18,0,10,0" />
                            <TextBox Grid.Column="5" Text="{Binding LeaseTimeText}" />
                        </Grid>
                        <Button Content="保存 DHCP 设置" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Command="{Binding SaveDhcpCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DNS 与 IPv6" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="手动指定 DNS 服务器" IsChecked="{Binding DnsEnable}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="首选 DNS" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" Text="{Binding Dns1}" IsEnabled="{Binding DnsEnable}" />
                            <TextBlock Grid.Column="2" Text="备用 DNS" Style="{StaticResource FieldLabel}" Margin="18,0,10,0" />
                            <TextBox Grid.Column="3" Text="{Binding Dns2}" IsEnabled="{Binding DnsEnable}" />
                        </Grid>
                        <Button Content="保存 DNS 设置" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Command="{Binding SaveDnsCommand}" />

                        <Separator Margin="0,18,0,14" Background="{DynamicResource B.Border}" />
                        <CheckBox Content="启用 IPv6 地址分配（DHCPv6）" IsChecked="{Binding DhcpV6}" />
                        <Button Content="保存 IPv6 设置" Style="{StaticResource GhostButton}" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Command="{Binding SaveIpv6Command}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="静态 IP 绑定" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding StaticIps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RowBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Mac}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Ip}" Style="{StaticResource Note}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="删除" Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.DeleteStaticIpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="（设备当前没有绑定记录）" Style="{StaticResource Note}" Margin="0,4,0,0"
                                   Visibility="{Binding StaticIps.Count, Converter={StaticResource ZeroToVisibility}}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MAC 地址" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" Text="{Binding NewStaticMac}" />
                            <TextBlock Grid.Column="2" Text="绑定 IP" Style="{StaticResource FieldLabel}" Margin="18,0,10,0" />
                            <TextBox Grid.Column="3" Text="{Binding NewStaticIp}" />
                            <Button Grid.Column="4" Content="添加绑定" Style="{StaticResource PrimaryButton}" Margin="18,0,0,0"
                                    Command="{Binding AddStaticIpCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="强制门户重定向（原厂界面未提供）" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="启用重定向" IsChecked="{Binding RedirectEnable}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="目标地址" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <TextBox Text="{Binding RedirectUrl}" Width="360" />
                        </StackPanel>
                        <TextBlock Text="{Binding RedirectNote}" Style="{StaticResource Note}" Margin="0,12,0,0" />
                        <Button Content="保存重定向设置" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Command="{Binding SaveRedirectCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
