<UserControl x:Class="NRadioManager.Views.C2000SignalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NRadioManager.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="当前信号质量" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Text="{Binding CurrentQualityText}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B.Text}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button Content="立即刷新" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}"
                                    Padding="12,5" />
                            <TextBlock Text="{Binding LastSampleText}" Style="{StaticResource Note}"
                                       HorizontalAlignment="Right" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="4">
                        <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="{DynamicResource R.Small}"
                                Padding="6" Margin="0,0,8,0">
                            <controls:MetricGauge Height="158" Title="RSRP" Unit=" dBm" Minimum="-140" Maximum="-40"
                                                  Value="{Binding RsrpValue}" Kind="SignalRsrp"
                                                  Description="参考信号接收功率；越高表示覆盖越强" />
                        </Border>
                        <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="{DynamicResource R.Small}"
                                Padding="6" Margin="0,0,8,0">
                            <controls:MetricGauge Height="158" Title="RSRQ" Unit=" dB" Minimum="-30" Maximum="0"
                                                  Value="{Binding RsrqValue}" Kind="SignalRsrq"
                                                  Description="参考信号接收质量；反映负载和干扰" />
                        </Border>
                        <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="{DynamicResource R.Small}"
                                Padding="6" Margin="0,0,8,0">
                            <controls:MetricGauge Height="158" Title="SINR" Unit=" dB" Minimum="-10" Maximum="30"
                                                  Value="{Binding SinrValue}" Kind="SignalSinr"
                                                  Description="信号与干扰噪声比；越高代表链路越干净" />
                        </Border>
                        <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="{DynamicResource R.Small}"
                                Padding="6">
                            <controls:MetricGauge Height="158" Title="CQI" Unit="" Minimum="0" Maximum="15"
                                                  Value="{Binding CqiValue}" Kind="Cqi"
                                                  Description="信道质量指示；设备实测编码质量等级" />
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding RangeTitle}" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Text="RSRP 质量分区 + RSRQ / SINR 同轴趋势 · 悬停查看精确数据"
                                       Style="{StaticResource Note}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="1 小时" Command="{Binding SelectRangeCommand}" CommandParameter="1h"
                                    Style="{StaticResource GhostButton}" Margin="0,0,6,0" Padding="11,5" />
                            <Button Content="6 小时" Command="{Binding SelectRangeCommand}" CommandParameter="6h"
                                    Style="{StaticResource GhostButton}" Margin="0,0,6,0" Padding="11,5" />
                            <Button Content="24 小时" Command="{Binding SelectRangeCommand}" CommandParameter="24h"
                                    Style="{StaticResource GhostButton}" Margin="0,0,6,0" Padding="11,5" />
                            <Button Content="7 天" Command="{Binding SelectRangeCommand}" CommandParameter="7d"
                                    Style="{StaticResource GhostButton}" Padding="11,5" />
                        </StackPanel>
                    </Grid>

                    <controls:SignalAnalysisChart Points="{Binding SignalMetrics}" Height="345" Margin="0,6,0,0" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding AnalysisRecommendation}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource B.Text}" />
                            <TextBlock Text="{Binding SourceNote}" Style="{StaticResource Note}" Margin="0,5,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SampleCountText}" Style="{StaticResource Note}"
                                   Margin="16,0,0,0" VerticalAlignment="Top" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="当前小区" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Columns="4">
                            <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="{DynamicResource R.Small}"
                                    Padding="12,9" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Band" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding Band}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="{DynamicResource R.Small}"
                                    Padding="12,9" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="PCI" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding Pci}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="{DynamicResource R.Small}"
                                    Padding="12,9" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="NR-ARFCN" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding Earfcn}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="{DynamicResource R.Small}"
                                    Padding="12,9">
                                <StackPanel>
                                    <TextBlock Text="带宽" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding Bandwidth}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="小区标识与状态" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource FieldValue}">
                            <Run Text="NCI / ECI  " /><Run Text="{Binding Cell, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource FieldValue}" Margin="0,7,0,0">
                            <Run Text="连接状态  " /><Run Text="{Binding ConnectionText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource FieldValue}" Margin="0,7,0,0">
                            <Run Text="更新时间  " /><Run Text="{Binding UpdateText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
