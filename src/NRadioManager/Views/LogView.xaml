<UserControl x:Class="NRadioManager.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="通信日志（本地持久化）" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding LogNote}" Style="{StaticResource Note}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RetentionNote}" Style="{StaticResource Note}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LogFilePath}" Style="{StaticResource Note}" Margin="0,4,0,0"
                               FontFamily="Consolas" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LoadWarning}" Style="{StaticResource Note}"
                               Foreground="{DynamicResource B.Warn}" TextWrapping="Wrap"
                               Visibility="{Binding HasLoadWarning, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StorageError}" Style="{StaticResource Note}"
                               Foreground="{DynamicResource B.Danger}" TextWrapping="Wrap"
                               Visibility="{Binding HasStorageError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="打开日志目录" Style="{StaticResource GhostButton}"
                            Command="{Binding OpenFolderCommand}" />
                    <Button Content="清空持久化日志" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding ClearCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="搜索" Style="{StaticResource Note}" VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" />
                <TextBlock Grid.Column="2" Text="类别" Style="{StaticResource Note}" VerticalAlignment="Center"
                           Margin="14,0,8,0" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding CategoryOptions}"
                          SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Text" />
                <TextBlock Grid.Column="4" Text="级别" Style="{StaticResource Note}" VerticalAlignment="Center"
                           Margin="14,0,8,0" />
                <ComboBox Grid.Column="5" ItemsSource="{Binding LevelOptions}"
                          SelectedItem="{Binding SelectedLevel}" DisplayMemberPath="Text" />
                <TextBlock Grid.Column="6" Text="{Binding CountText}" Style="{StaticResource Note}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0" />
                <Button Grid.Column="7" Content="刷新" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <ListBox ItemsSource="{Binding FilteredItems}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="142" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DateText}" Style="{StaticResource Note}"
                                           FontFamily="Consolas" />
                                <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Foreground" Value="{DynamicResource B.Danger}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{DynamicResource B.Warn}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Success">
                                                    <Setter Property="Foreground" Value="{DynamicResource B.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding CategoryText}" Style="{StaticResource Note}" />
                                <TextBlock Grid.Column="3" Text="{Binding SourceText}" Style="{StaticResource Note}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"
                                           ToolTip="{Binding Detail}" ToolTipService.ShowDuration="30000" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="当前筛选条件下没有日志。" Style="{StaticResource Note}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
