<UserControl x:Class="NRadioManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NRadioManager.Controls">

    <UserControl.Resources>

        <!-- ============ 磁贴内容模板 ============ -->

        <DataTemplate x:Key="TileOverview">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="3">
                    <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="{DynamicResource R.Small}"
                            Padding="10,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="月套餐" Style="{StaticResource FieldLabel}" />
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="27"
                                     HorizontalAlignment="Left" Margin="0,3,0,0">
                                <TextBlock Text="{Binding Owner.MonthlyPlanText}" FontSize="20" FontWeight="SemiBold" />
                            </Viewbox>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource B.AccentSoft}" CornerRadius="{DynamicResource R.Small}"
                            Padding="10,8" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="已消耗" Style="{StaticResource FieldLabel}" />
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="27"
                                     HorizontalAlignment="Left" Margin="0,3,0,0">
                                <TextBlock Text="{Binding Owner.MonthlyUsedText}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource B.Accent}" />
                            </Viewbox>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="{DynamicResource R.Small}"
                            Padding="10,8" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="剩余" Style="{StaticResource FieldLabel}" />
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="27"
                                     HorizontalAlignment="Left" Margin="0,3,0,0">
                                <TextBlock Text="{Binding Owner.MonthlyRemainingText}" FontSize="20" FontWeight="SemiBold" />
                            </Viewbox>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1" Background="{DynamicResource B.SurfaceAlt}" CornerRadius="{DynamicResource R.Small}"
                        Padding="11,9" Margin="0,9,0,8" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ProgressBar Value="{Binding Owner.MonthlyUsagePercent, Mode=OneWay}" Maximum="100" Height="8" />
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Owner.MonthlyUsageStatusText}" FontSize="12" FontWeight="SemiBold" />
                            <Border HorizontalAlignment="Right" Background="{DynamicResource B.Surface}"
                                    CornerRadius="8" Padding="7,1">
                                <TextBlock Text="{Binding Owner.MonthlyUsageModeText}" Style="{StaticResource Note}"
                                           FontSize="10.5" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding Owner.MonthlyUsageSourceText}"
                                   Style="{StaticResource Note}" Margin="0,5,0,0" TextWrapping="Wrap"
                                   VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,5,6">
                        <TextBlock Text="月套餐 (GB)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Owner.MonthlyPlanInputGb, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="7,5" FontSize="12.5" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,0,6">
                        <TextBlock Text="已消耗 (GB)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Owner.MonthlyUsedInputGb, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="7,5" FontSize="12.5" Margin="0,3,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="保存套餐" Style="{StaticResource PrimaryButton}"
                                Padding="8,5" FontSize="11.5" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                Command="{Binding Owner.SaveTrafficPlanCommand}" />
                        <Button Grid.Column="1" Content="用终端值" Style="{StaticResource GhostButton}"
                                Padding="7,5" FontSize="11" HorizontalAlignment="Stretch" Margin="4,0,4,0"
                                Command="{Binding Owner.UseDeviceUsageCommand}" />
                        <Button Grid.Column="2" Content="本地清零" Style="{StaticResource GhostButton}"
                                Padding="7,5" FontSize="11" HorizontalAlignment="Stretch" Margin="4,0,0,0"
                                Command="{Binding Owner.ResetTrafficStatisticsCommand}" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TileStats">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="当日" Style="{StaticResource SegmentItem}" GroupName="StatsPeriod"
                                     IsChecked="{Binding Owner.IsDayPeriod}" />
                        <RadioButton Content="近七天" Style="{StaticResource SegmentItem}" GroupName="StatsPeriod"
                                     IsChecked="{Binding Owner.IsWeekPeriod}" />
                        <RadioButton Content="本月" Style="{StaticResource SegmentItem}" GroupName="StatsPeriod"
                                     IsChecked="{Binding Owner.IsMonthPeriod}" />
                    </StackPanel>
                </Border>

                <controls:BarChart Grid.Row="1" Margin="0,9,0,0" MinHeight="135"
                                   Items="{Binding Owner.Bars}" x:Name="TrafficBar"
                                   BarSelected="OnBarSelected" />

                <Border Grid.Row="2" Background="{DynamicResource B.SurfaceAlt}"
                        CornerRadius="{DynamicResource R.Small}" Padding="10,7" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Owner.PeriodSummary}" FontSize="12.5" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Owner.PeriodScope}" Style="{StaticResource Note}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Owner.DetailTitle}" Style="{StaticResource Note}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TileSpeedChart">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:TrendChart Points="{Binding Owner.Samples}" Mode="Speed" MinHeight="145" />
                <TextBlock Grid.Row="1" Style="{StaticResource Note}" Margin="0,8,0,0"
                           Text="{Binding Owner.SpeedChartNote}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TileResourceHealth">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <UniformGrid Columns="3">
                    <controls:MetricGauge Title="CPU" Unit="%" Minimum="0" Maximum="100"
                                          Value="{Binding Owner.CpuPercent}" Kind="Percent"
                                          Description="CPU 利用率；悬停查看等级" Margin="0,0,4,0" />
                    <controls:MetricGauge Title="内存" Unit="%" Minimum="0" Maximum="100"
                                          Value="{Binding Owner.MemoryPercent}" Kind="Percent"
                                          Description="内存利用率；悬停查看等级" Margin="4,0,4,0" />
                    <controls:MetricGauge Title="温度" Unit="℃" Minimum="0" Maximum="90"
                                          Value="{Binding Owner.TemperatureC}" Kind="Temperature"
                                          Description="模块温度；悬停查看等级" Margin="4,0,0,0" />
                </UniformGrid>
                <TextBlock Grid.Row="1" Style="{StaticResource Note}" Margin="0,6,0,0"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="设备实时上报 · 悬停任一环形指标查看状态说明" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TileStatus">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Owner.ConnectionState}" Style="{StaticResource BigValue}" FontSize="27" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,3,0,0">
                        <Run Text="{Binding Owner.Operator, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Owner.NetworkMode, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Border Grid.Row="1" Background="{DynamicResource B.SurfaceAlt}"
                        CornerRadius="{DynamicResource R.Small}" Padding="11,8"
                        VerticalAlignment="Center" Margin="0,8,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="在线终端" Style="{StaticResource FieldLabel}" Margin="0,0,16,7" />
                        <TextBlock Grid.Column="1" Text="{Binding Owner.ClientsText}" FontSize="15"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,0,7" />
                        <TextBlock Grid.Row="1" Text="运行时长" Style="{StaticResource FieldLabel}" Margin="0,0,16,7" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Owner.RunTimeText}" FontSize="13"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,0,7" />
                        <TextBlock Grid.Row="2" Text="电池" Style="{StaticResource FieldLabel}" Margin="0,0,16,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Owner.BatteryText}"
                                   FontSize="12.5" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
                <TextBlock Grid.Row="2" Text="{Binding Owner.DataUpdatedText}" Style="{StaticResource Note}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TileSignal">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:MetricGauge Title="RSRP 信号质量" Unit=" dBm" Minimum="-140" Maximum="-40"
                                      Value="{Binding Owner.RsrpDbm}" Kind="SignalRsrp"
                                      Description="覆盖越强数值越高；悬停查看完整状态" />
                <TextBlock Grid.Row="1" Text="{Binding Owner.SignalDetail}" Style="{StaticResource Note}"
                           Margin="0,5,0,0" TextAlignment="Center" FontSize="12.5" />
                <Border Grid.Row="2" Background="{DynamicResource B.SurfaceAlt}"
                        CornerRadius="{DynamicResource R.Small}" Padding="8,6" Margin="0,7,0,0">
                    <UniformGrid Columns="2">
                        <StackPanel Orientation="Horizontal" Margin="2,1">
                            <Ellipse Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center" />
                            <TextBlock Text="优秀 ≥ -80" Style="{StaticResource Note}" Margin="6,0,0,0" FontSize="11.5" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="2,1">
                            <Ellipse Width="8" Height="8" Fill="#3B82F6" VerticalAlignment="Center" />
                            <TextBlock Text="良好 ≥ -90" Style="{StaticResource Note}" Margin="6,0,0,0" FontSize="11.5" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="2,1">
                            <Ellipse Width="8" Height="8" Fill="#F59E0B" VerticalAlignment="Center" />
                            <TextBlock Text="一般 ≥ -100" Style="{StaticResource Note}" Margin="6,0,0,0" FontSize="11.5" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="2,1">
                            <Ellipse Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center" />
                            <TextBlock Text="较差 &lt; -100" Style="{StaticResource Note}" Margin="6,0,0,0" FontSize="11.5" />
                        </StackPanel>
                    </UniformGrid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TileDeviceInfo">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="设备名称" Style="{StaticResource FieldLabel}" Margin="0,2,12,7" />
                <TextBlock Grid.Row="1" Text="固件版本" Style="{StaticResource FieldLabel}" Margin="0,2,12,7" />
                <TextBlock Grid.Row="2" Text="硬件版本" Style="{StaticResource FieldLabel}" Margin="0,2,12,7" />
                <TextBlock Grid.Row="3" Text="IMEI" Style="{StaticResource FieldLabel}" Margin="0,2,12,7" />
                <TextBlock Grid.Row="4" Text="ICCID" Style="{StaticResource FieldLabel}" Margin="0,2,12,7" />
                <TextBlock Grid.Row="5" Text="WAN / LAN" Style="{StaticResource FieldLabel}" Margin="0,2,12,7" />
                <TextBlock Grid.Row="6" Text="SSID" Style="{StaticResource FieldLabel}" Margin="0,2,12,7" />
                <TextBlock Grid.Row="7" Text="MAC" Style="{StaticResource FieldLabel}" Margin="0,2,12,7" />
                <TextBlock Grid.Row="8" Text="序列号" Style="{StaticResource FieldLabel}" Margin="0,2,12,0" />
                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Owner.DeviceName}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,7" />
                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Owner.FirmwareVersion}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,7" />
                <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding Owner.HardwareVersion}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,7" />
                <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding Owner.Imei}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,7" />
                <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding Owner.Iccid}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,7" />
                <TextBlock Grid.Column="1" Grid.Row="5" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,7">
                    <Run Text="{Binding Owner.WanIp, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Owner.LanIp, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Grid.Column="1" Grid.Row="6" Text="{Binding Owner.Ssid}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,7" />
                <TextBlock Grid.Column="1" Grid.Row="7" Text="{Binding Owner.MacAddress}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,7" />
                <TextBlock Grid.Column="1" Grid.Row="8" Text="{Binding Owner.SerialNumber}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TileNetwork">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Owner.PdpSummary}" FontSize="14" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <Border Grid.Row="1" Background="{DynamicResource B.SurfaceAlt}"
                        CornerRadius="{DynamicResource R.Small}" Padding="10,8" Margin="0,8,0,8">
                    <TextBlock Text="{Binding Owner.LteCellSummary}" Style="{StaticResource Note}" />
                </Border>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding Owner.TrafficText}" Style="{StaticResource FieldValue}" />
                    <TextBlock Text="{Binding Owner.MonthDeviceLevelText}" Style="{StaticResource Note}" Margin="0,7,0,0" />
                    <TextBlock Text="{Binding Owner.Month3DayDeviceText}" Style="{StaticResource Note}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ============ 磁贴外壳（标题栏 + 编辑操作 + 拖动） ============ -->
        <DataTemplate x:Key="TileHost">
            <Border ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Tile}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter Property="Opacity" Value="0.65" />
                                <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,7">
                        <StackPanel Orientation="Horizontal" Cursor="SizeAll" Tag="TileDragHandle"
                                      ToolTip="编辑模式下从标题处拖动，松开后保存顺序">
                            <TextBlock Text="&#xE76F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12" Foreground="{DynamicResource B.TextFaint}" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding ShowTitle, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding Owner.IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="标题" Style="{StaticResource GhostButton}" Padding="8,2"
                                    ToolTip="显示/隐藏该磁贴标题"
                                    Command="{Binding Owner.ToggleTileTitleCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>

                    <ContentControl Grid.Row="1" Content="{Binding}" ClipToBounds="True"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource TileStatus}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Overview">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TileOverview}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Stats">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TileStats}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="SpeedChart">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TileSpeedChart}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="ResourceHealth">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TileResourceHealth}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Signal">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TileSignal}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="DeviceInfo">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TileDeviceInfo}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Network">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TileNetwork}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="{DynamicResource R.Small}" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource B.DangerSoft}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
        </Border>

        <!-- 磁贴操作入口（原先这里还有一条与通知重复的提示横幅，已移除，提示统一走通知中心） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <TextBlock Text="{Binding SaveStatusText}" Style="{StaticResource Note}" VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Visibility="{Binding SaveStatusText, Converter={StaticResource StrToVisibility}}" />
            <!-- 与「恢复默认布局」使用同一套 Command 机制（Click 事件在这块区域不生效） -->
            <Button x:Name="DoneEditButton" Content="完成" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                    Command="{Binding FinishEditingCommand}"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="编辑磁贴" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                    Command="{Binding ToggleEditModeCommand}"
                    ToolTip="{Binding LayoutHint}"
                    Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="恢复默认布局" Style="{StaticResource GhostButton}"
                    Command="{Binding ResetLayoutCommand}" />
        </StackPanel>

        <ItemsControl Grid.Row="2" x:Name="TilesHost" ItemsSource="{Binding Tiles}"
                      ItemTemplate="{StaticResource TileHost}" VerticalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:TileGrid />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</UserControl>
