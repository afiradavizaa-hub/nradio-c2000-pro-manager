<UserControl x:Class="NRadioManager.Views.C2000CellularView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="当前蜂窝连接" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource FieldValue}">
                            <Run Text="{Binding Mode, Mode=OneWay}" />
                            <Run Text=" · " /><Run Text="{Binding Operator, Mode=OneWay}" />
                            <Run Text=" · " /><Run Text="{Binding Registration, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0">
                            <Run Text="设备型号 " /><Run Text="{Binding Model, Mode=OneWay}" />
                            <Run Text=" · 固件 " /><Run Text="{Binding Firmware, Mode=OneWay}" />
                            <Run Text=" · 更新 " /><Run Text="{Binding UpdatedText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="刷新" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="SIM 与网络注册" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="当前卡位" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding CurrentSlot}" Style="{StaticResource FieldValue}" />
                            <TextBlock Text="SIM 运营商" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding SimOperator}" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0">
                            <TextBlock Text="APN" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding Apn}" Style="{StaticResource FieldValue}" />
                            <TextBlock Text="IMEI" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding Imei}" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="IMSI" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding Imsi}" Style="{StaticResource FieldValue}" />
                            <TextBlock Text="ICCID" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding Iccid}" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="WAN 与地址" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource FieldValue}">
                        <Run Text="IPv4  " /><Run Text="{Binding Ipv4, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,8,0,0">
                        <Run Text="IPv6  " /><Run Text="{Binding Ipv6, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,8,0,0">
                        <Run Text="DNS  " /><Run Text="{Binding Dns, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0">
                        <Run Text="WAN 已连接 " /><Run Text="{Binding WanUptime, Mode=OneWay}" />
                        <Run Text=" · 设备运行 " /><Run Text="{Binding Uptime, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="蜂窝模块与资源" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource FieldValue}">
                        <Run Text="模块 " /><Run Text="{Binding Module, Mode=OneWay}" />
                        <Run Text=" · 模块固件 " /><Run Text="{Binding ModuleFirmware, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0">
                        <Run Text="CPU " /><Run Text="{Binding CpuText, Mode=OneWay}" />
                        <Run Text=" · 内存 " /><Run Text="{Binding MemoryText, Mode=OneWay}" />
                        <Run Text=" · 模块温度 " /><Run Text="{Binding TemperatureText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding SourceNote}" Style="{StaticResource Note}" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="网络制式（专业版）" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding NetworkModeOptions}" DisplayMemberPath="Text"
                                  SelectedItem="{Binding SelectedNetworkMode}" Width="190" />
                        <Button Content="确认并应用" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                Command="{Binding SaveNetworkModeCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding NetworkModeOperation}" Style="{StaticResource Note}" Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="修改前会通过原厂完整 CBI 表单保留其他字段；仅在页面回读与选择一致时报告成功。"
                               Style="{StaticResource Note}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
