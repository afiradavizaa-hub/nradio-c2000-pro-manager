<UserControl x:Class="NRadioManager.Views.C2000WifiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="局域网" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding LanAddress}" Style="{StaticResource FieldValue}" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,5,0,0">
                            <Run Text="{Binding DhcpState, Mode=OneWay}" />
                            <Run Text=" · " /><Run Text="{Binding ClientCount, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="刷新" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,12">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="2.4 GHz" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding Wifi24Summary}" Style="{StaticResource Note}" />
                            </StackPanel>
                            <CheckBox Content="启用" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      IsChecked="{Binding Wifi24Enabled}" />
                        </Grid>
                        <TextBlock Text="SSID" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                        <TextBox Text="{Binding Ssid24Input, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="新密码（留空保持）" Style="{StaticResource FieldLabel}" Margin="0,9,0,5" />
                        <PasswordBox x:Name="Password24Box" PasswordChanged="OnPassword24Changed" />
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="信道" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding Channels24}" DisplayMemberPath="Text"
                                          SelectedValuePath="Value" SelectedValue="{Binding Channel24Input}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="带宽" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding Bandwidth24}" DisplayMemberPath="Text"
                                          SelectedValuePath="Value" SelectedValue="{Binding Bandwidth24Input}" />
                            </StackPanel>
                        </Grid>
                        <Button Content="应用 2.4 GHz 设置" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                HorizontalAlignment="Stretch" Command="{Binding Save24Command}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,12">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="5 GHz" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding Wifi5Summary}" Style="{StaticResource Note}" />
                            </StackPanel>
                            <CheckBox Content="启用" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      IsChecked="{Binding Wifi5Enabled}" />
                        </Grid>
                        <TextBlock Text="SSID" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                        <TextBox Text="{Binding Ssid5Input, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="新密码（留空保持）" Style="{StaticResource FieldLabel}" Margin="0,9,0,5" />
                        <PasswordBox x:Name="Password5Box" PasswordChanged="OnPassword5Changed" />
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="信道" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding Channels5}" DisplayMemberPath="Text"
                                          SelectedValuePath="Value" SelectedValue="{Binding Channel5Input}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="带宽" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding Bandwidth5}" DisplayMemberPath="Text"
                                          SelectedValuePath="Value" SelectedValue="{Binding Bandwidth5Input}" />
                            </StackPanel>
                        </Grid>
                        <Button Content="应用 5 GHz 设置" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                HorizontalAlignment="Stretch" Command="{Binding Save5Command}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="操作状态" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding OperationText}" Style="{StaticResource FieldValue}" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Note}" Margin="0,7,0,0" />
                    <TextBlock Text="{Binding PasswordNote}" Style="{StaticResource Note}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
