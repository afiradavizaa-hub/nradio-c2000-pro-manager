<UserControl x:Class="NRadioManager.Views.C2000SmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0"
                VerticalAlignment="Stretch">
            <StackPanel>
                <Grid>
                    <TextBlock Text="短信服务" Style="{StaticResource SectionTitle}" />
                    <Button Content="刷新" Style="{StaticResource GhostButton}" Padding="10,4"
                            HorizontalAlignment="Right" Command="{Binding RefreshCommand}" />
                </Grid>
                <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="{DynamicResource R.Small}"
                        Padding="14" Margin="0,4,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding ServiceText}" Style="{StaticResource FieldValue}"
                                   FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0">
                            <Run Text="未读 " /><Run Text="{Binding UnreadText, Mode=OneWay}" />
                            <Run Text=" · 容量 " /><Run Text="{Binding CapacityText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <TextBlock Text="隐私说明" Style="{StaticResource ListHeader}" />
                <TextBlock Text="短信正文和号码只在当前页面显示，不写入普通运行日志。发送前会再次确认并可能产生运营商费用。"
                           Style="{StaticResource Note}" />
                <TextBlock Text="{Binding SendNote}" Style="{StaticResource Note}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding OperationText}" Style="{StaticResource Note}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="0" Grid.Column="1">
        <Border Style="{StaticResource Card}" Height="330">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="消息" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding MessageCountText}" Style="{StaticResource Note}"
                               HorizontalAlignment="Right" />
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Messages}" Background="Transparent"
                         BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource B.SurfaceAlt}"
                                    BorderBrush="{DynamicResource B.BorderSoft}" BorderThickness="1"
                                    CornerRadius="{DynamicResource R.Small}" Padding="14,11" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource B.AccentSoft}" CornerRadius="9"
                                                    Padding="8,2">
                                                <TextBlock Text="{Binding Contact}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Date}" Style="{StaticResource Note}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding Content}" Style="{StaticResource FieldValue}"
                                               Margin="0,9,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="1" Background="{DynamicResource B.SurfaceAlt}"
                        CornerRadius="{DynamicResource R.Small}" Padding="20" VerticalAlignment="Center"
                        Margin="10,40">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMessages}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="暂无短信" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="当前短信服务不可用或存储中没有消息。服务状态与真实原因见左侧。"
                                   Style="{StaticResource Note}" Margin="0,8,0,0" TextAlignment="Center" />
                        <UniformGrid Columns="3" Margin="0,20,0,0">
                            <Border Background="{DynamicResource B.Surface}" CornerRadius="{DynamicResource R.Small}"
                                    Padding="12" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="服务条件" Style="{StaticResource ListHeader}" />
                                    <TextBlock Text="需要当前 SIM 支持短信，并满足 IMS/运营商注册条件。"
                                               Style="{StaticResource Note}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource B.Surface}" CornerRadius="{DynamicResource R.Small}"
                                    Padding="12" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="当前判断" Style="{StaticResource ListHeader}" />
                                    <TextBlock Text="{Binding ServiceText}" Style="{StaticResource Note}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource B.Surface}" CornerRadius="{DynamicResource R.Small}"
                                    Padding="12" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="显示原则" Style="{StaticResource ListHeader}" />
                                    <TextBlock Text="没有真实消息时不会生成占位内容或伪造发送记录。"
                                               Style="{StaticResource Note}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="短信可用条件" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="1. 当前 SIM 卡槽必须被设备识别并完成网络注册。"
                               Style="{StaticResource FieldValue}" Margin="0,2,0,0" />
                    <TextBlock Text="2. 运营商需为号码开通短信能力，且设备侧 IMS 服务开启。"
                               Style="{StaticResource FieldValue}" Margin="0,4,0,0" />
                    <TextBlock Text="3. 设备返回 on=1 且 ready=1 时，发送表单才会显示。"
                               Style="{StaticResource FieldValue}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="当前诊断" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding ServiceText}" Style="{StaticResource FieldValue}" />
                    <TextBlock Text="{Binding OperationText}" Style="{StaticResource Note}" Margin="0,7,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        </StackPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding CanSend, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="发送短信" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="收件号码" Style="{StaticResource FieldLabel}" Margin="0,6,10,6" />
                    <TextBox Grid.Column="1" Text="{Binding Recipient, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="正文" Style="{StaticResource FieldLabel}" Margin="16,6,10,6" />
                    <TextBox Grid.Column="3" Text="{Binding SmsBody, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Height="58" TextWrapping="Wrap" />
                </Grid>
                <Button Content="确认发送" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"
                        HorizontalAlignment="Left" Command="{Binding SendCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
