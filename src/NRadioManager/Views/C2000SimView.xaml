<UserControl x:Class="NRadioManager.Views.C2000SimView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SIM 卡位" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource FieldValue}">
                            <Run Text="当前 " /><Run Text="{Binding CurrentSlot, Mode=OneWay}" />
                            <Run Text=" · 可用 " /><Run Text="{Binding SlotCount, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource FieldValue}" Margin="0,8,0,0">
                            <Run Text="切换模式 " /><Run Text="{Binding SwitchMode, Mode=OneWay}" />
                            <Run Text=" · 注册 " /><Run Text="{Binding Registration, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="刷新" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="当前卡信息" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource FieldValue}">
                        <Run Text="运营商 " /><Run Text="{Binding SimOperator, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,8,0,0">
                        <Run Text="PIN 状态 " /><Run Text="{Binding PinState, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,8,0,0">
                        <Run Text="IMSI " /><Run Text="{Binding Imsi, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource FieldValue}" Margin="0,8,0,0">
                        <Run Text="ICCID " /><Run Text="{Binding Iccid, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Note}" Margin="0,14,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="切换到 SIM1" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Command="{Binding SwitchToSlotCommand}" CommandParameter="1"
                                IsEnabled="{Binding CanSwitchSim}" />
                        <Button Content="切换到 SIM2" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Command="{Binding SwitchToSlotCommand}" CommandParameter="2"
                                IsEnabled="{Binding CanSwitchSim}" />
                        <Button Content="恢复自动选卡" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RestoreAutoCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding OperationText}" Style="{StaticResource FieldValue}" Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
