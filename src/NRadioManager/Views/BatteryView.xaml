<UserControl x:Class="NRadioManager.Views.BatteryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NRadioManager.Controls">
    <UserControl.Resources>
        <Style x:Key="MetricTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource B.SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B.BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource R.Small}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Width" Value="218" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- ===== 实时状态 ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource B.SurfaceAlt}"
                                CornerRadius="{DynamicResource R.Small}" Padding="16,12" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <controls:BatteryGauge Width="108" Height="54" VerticalAlignment="Center"
                                                       Percent="{Binding PercentValue}"
                                                       Charging="{Binding IsCharging}"
                                                       Full="{Binding IsFull}" />
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PercentText}" Style="{StaticResource BigValue}" FontSize="32" />
                                    <TextBlock Text="{Binding ChargeStateText}" Style="{StaticResource FieldValue}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="24,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="电池状态" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding LiveUpdatedText}" Style="{StaticResource Note}" />
                            <TextBlock Text="{Binding LastSampleText}" Style="{StaticResource Note}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding HistoryCoverageText}" Style="{StaticResource Note}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding ChargeDetailText}" Style="{StaticResource Note}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding SamplingStatusText}" Style="{StaticResource Note}" Margin="0,3,0,0"
                                       Foreground="{DynamicResource B.Warn}"
                                       Visibility="{Binding HasSamplingProblem, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding BatteryConnectText}" Style="{StaticResource Note}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Border Background="{DynamicResource B.AccentSoft}" CornerRadius="6" Padding="10,5">
                                <TextBlock Text="{Binding ConnectionText}" FontSize="12"
                                           Foreground="{DynamicResource B.Text}" />
                            </Border>
                            <TextBlock Text="{Binding RangeLabel}" Style="{StaticResource Note}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding DataSourceText}" Style="{StaticResource Note}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding UnsupportedText}" Style="{StaticResource Note}" Margin="0,6,0,0"
                               Foreground="{DynamicResource B.Warn}" />
                    <TextBlock Text="{Binding DataWarning}" Style="{StaticResource Note}" Margin="0,6,0,0"
                               Foreground="{DynamicResource B.Warn}"
                               Visibility="{Binding HasDataWarning, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding HistoryWarningText}" Style="{StaticResource Note}" Margin="0,6,0,0"
                               Foreground="{DynamicResource B.Warn}"
                               Visibility="{Binding HasHistoryWarning, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding SaveWarningText}" Style="{StaticResource Note}" Margin="0,6,0,0"
                               Foreground="{DynamicResource B.Danger}"
                               Visibility="{Binding HasSaveWarning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- ===== 趋势图 ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="电量趋势（真实采样）" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Text="{Binding RangeWindowText}" Style="{StaticResource Note}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <ComboBox ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}"
                                      DisplayMemberPath="Text" Width="132" />
                            <Button Content="恢复默认视图" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Click="ResetChart_Click" />
                        </StackPanel>
                    </Grid>

                    <controls:BatteryChart x:Name="Chart" Height="310" Margin="0,10,0,0"
                                           Samples="{Binding Samples}"
                                           RangeSeconds="{Binding RangeSeconds}"
                                           GapThresholdSeconds="{Binding GapThresholdSeconds}"
                                           ViewStartUtc="{Binding ViewStartUtc, Mode=TwoWay}"
                                           ViewEndUtc="{Binding ViewEndUtc, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                               Text="悬停查看采样时间、电量和状态；左键拖动平移；滚轮缩放；双击图表或点「恢复默认视图」回到当前范围。曲线不会跨越缺失、断连或设备重启区间。" />
                </StackPanel>
            </Border>

            <!-- ===== 区间分析 ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="区间分析（仅基于真实采样）" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding AnalysisStatusText}" Style="{StaticResource Note}"
                               Foreground="{DynamicResource B.Warn}" Margin="0,0,0,8"
                               Visibility="{Binding HasAnalysisWarning, Converter={StaticResource BoolToVisibility}}" />

                    <WrapPanel>
                        <Border Style="{StaticResource MetricTile}">
                            <StackPanel>
                                <TextBlock Text="电量变化" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding NetChangeText}" Style="{StaticResource FieldValue}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding TrendText}" Style="{StaticResource Note}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricTile}">
                            <StackPanel>
                                <TextBlock Text="观测平均下降速度" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding AverageRateText}" Style="{StaticResource FieldValue}" Margin="0,4,0,0" />
                                <TextBlock Text="仅连续放电区间" Style="{StaticResource Note}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricTile}">
                            <StackPanel>
                                <TextBlock Text="数据覆盖" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding CoverageText}" Style="{StaticResource FieldValue}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding MissingSummaryText}" Style="{StaticResource Note}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricTile}">
                            <StackPanel>
                                <TextBlock Text="充放电时长" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding ChargingText}" Style="{StaticResource Note}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricTile}">
                            <StackPanel>
                                <TextBlock Text="缺口与异常" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding GapsText}" Style="{StaticResource Note}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricTile}">
                            <StackPanel>
                                <TextBlock Text="采样点" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding SampleSummaryText}" Style="{StaticResource Note}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="{Binding RateDisclaimer}" Style="{StaticResource Note}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
